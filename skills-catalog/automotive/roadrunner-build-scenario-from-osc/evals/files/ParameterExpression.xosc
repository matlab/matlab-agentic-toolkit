    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="Ambulance">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition laneId="-2" offset="-0.000000" roadId="242" s="14.1582">
                                    <Orientation h="0.17029" p="0" r="0" type="absolute"/>
                                </LanePosition>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="linear" value="$Accel_time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="$Ego_speed"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="SpeedChangeStory">
            <Act name="SpeedChangeAct">
                <ManeuverGroup maximumExecutionCount="1" name="AmbulanceSpeedChangeGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Ambulance"/>
                    </Actors>
                    <Maneuver name="SpeedChangeManeuver">
                        <Event name="AccelerateEvent" priority="parallel">
                            <Action name="AccelerateAction">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="linear" value="$Accel_time"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="$Target_speed"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition conditionEdge="none" delay="0" name="AfterDelay">
                                        <ByValueCondition>
                                            <SimulationTimeCondition rule="greaterOrEqual" value="5"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="0" name="SimulationStart">
                            <ByValueCondition>
                                <SimulationTimeCondition rule="greaterOrEqual" value="0"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition conditionEdge="none" delay="0" name="">
                    <ByValueCondition>
                        <SimulationTimeCondition rule="greaterOrEqual" value="$Sim_duration"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
            <ConditionGroup>
                <Condition conditionEdge="none" delay="0" name="">
                    <ByEntityCondition>
                        <TriggeringEntities triggeringEntitiesRule="any">
                            <EntityRef entityRef="Ambulance"/>
                        </TriggeringEntities>
                        <EntityCondition>
                            <CollisionCondition>
                                <ByType type="vehicle"/>
                            </CollisionCondition>
                        </EntityCondition>
                    </ByEntityCondition>
                </Condition>
