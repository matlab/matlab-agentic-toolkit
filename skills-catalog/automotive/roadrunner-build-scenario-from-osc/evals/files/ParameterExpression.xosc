    <FileHeader author="MathWorks RoadRunner" date="2026-01-28T14:12:51" description="Exported from RoadRunner version R2026a (1.12.0.9492459b734)" revMajor="1" revMinor="3"/>
    <ParameterDeclarations>
		 <ParameterDeclaration name="Ego_speed_kph" parameterType="double" value="20"/>
		 <ParameterDeclaration name="Ego_speed" parameterType="double" value="${$Ego_speed_kph / 3.6}"/>
		 <ParameterDeclaration name="Accel_rate" parameterType="double" value="3"/>
		 <ParameterDeclaration name="Accel_time" parameterType="double" value="${$Ego_speed_kph / 3.6 / $Accel_rate}"/>
		 <ParameterDeclaration name="Target_speed_kph" parameterType="double" value="40"/>
		 <ParameterDeclaration name="Target_speed" parameterType="double" value="${($Target_speed_kph - $Ego_speed_kph) * 0.5 + $Ego_speed_kph / 3.6}"/>
		 <ParameterDeclaration name="Sim_duration" parameterType="double" value="${$Accel_time + 5 + 2 * $Accel_time}"/>
    </ParameterDeclarations>
    <VariableDeclarations/>
    <CatalogLocations/>
    <RoadNetwork>
