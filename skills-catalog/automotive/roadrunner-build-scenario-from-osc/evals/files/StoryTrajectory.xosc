                        </Event>
                        <Event name="Act_PedestrianGroup_Event" priority="parallel">
                            <Action name="Act_PedestrianGroup_Change_Speed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="cubic" value="2"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="3.5"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition conditionEdge="none" delay="0" name="Route_Complete">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition state="completeState" storyboardElementRef="Route_Init_Moved3" storyboardElementType="event"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="0" name="SimulationStart">
                            <ByValueCondition>
                                <SimulationTimeCondition rule="greaterOrEqual" value="0"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
            </Act>
            <Act name="Act2">
                <ManeuverGroup maximumExecutionCount="1" name="Act2_YellowGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="Yellow"/>
                    </Actors>
                    <Maneuver name="Act2_YellowGroup_Maneuver">
                        <Event name="Act2_YellowGroup_Event" priority="parallel">
                            <Action name="Act2_YellowGroup_Change_Speed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsDimension="rate" dynamicsShape="linear" value="5"/>
                                            <SpeedActionTarget>
                                                <RelativeTargetSpeed continuous="false" entityRef="Yellow" speedTargetValueType="delta" value="-10"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <ManeuverGroup maximumExecutionCount="1" name="Act2_GlobalGroup">
                    <Actors selectTriggeringEntities="false"/>
                    <Maneuver name="Act2_GlobalGroup_Maneuver">
                        <Event name="ForceActToExecuteUntilStopTrigger" priority="parallel">
                            <Action name="NeverExecutedAction">
                                <UserDefinedAction>
                                    <CustomCommandAction type="MW_WaitAction"/>
                                </UserDefinedAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition conditionEdge="none" delay="0" name="NeverSatisfiedCondition">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition state="completeState" storyboardElementRef="Story" storyboardElementType="story"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="0" name="Distance_To_Point">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="Yellow"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <DistanceCondition coordinateSystem="entity" freespace="true" relativeDistanceType="euclidianDistance" rule="lessOrEqual" value="15">
                                        <Position>
                                            <WorldPosition h="0" p="0" r="0" x="-29.6647" y="-5.16503" z="0"/>
                                        </Position>
                                    </DistanceCondition>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="0" name="Distance_To_Point2">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="Yellow"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <DistanceCondition coordinateSystem="entity" freespace="true" relativeDistanceType="euclidianDistance" rule="lessOrEqual" value="0">
                                        <Position>
                                            <WorldPosition h="0" p="0" r="0" x="-42.4513" y="5.09096" z="0.000004"/>
                                        </Position>
                                    </DistanceCondition>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition conditionEdge="none" delay="0" name="">
                    <ByEntityCondition>
                        <TriggeringEntities triggeringEntitiesRule="any">
                            <EntityRef entityRef="Yellow"/>
                        </TriggeringEntities>
                        <EntityCondition>
                            <DistanceCondition coordinateSystem="entity" freespace="true" relativeDistanceType="euclidianDistance" rule="lessOrEqual" value="1">
                                <Position>
                                    <WorldPosition h="0" p="0" r="0" x="-105.171" y="-8.27506" z="0"/>
                                </Position>
                            </DistanceCondition>
                        </EntityCondition>
                    </ByEntityCondition>
                </Condition>
            </ConditionGroup>
            <ConditionGroup>
                <Condition conditionEdge="none" delay="0" name="">
                    <ByEntityCondition>
                        <TriggeringEntities triggeringEntitiesRule="any">
                            <EntityRef entityRef="Yellow"/>
                            <EntityRef entityRef="White"/>
                            <EntityRef entityRef="Pedestrian"/>
                        </TriggeringEntities>
                        <EntityCondition>
                            <CollisionCondition>
                                <ByType type="vehicle"/>
                            </CollisionCondition>
                        </EntityCondition>
                    </ByEntityCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>