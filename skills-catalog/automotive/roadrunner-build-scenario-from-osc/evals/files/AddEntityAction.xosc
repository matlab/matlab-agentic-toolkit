                        <Condition conditionEdge="none" delay="0" name="SimulationStart4">
                            <ByValueCondition>
                                <SimulationTimeCondition rule="greaterOrEqual" value="0"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="5" name="Duration3">
                            <ByValueCondition>
                                <StoryboardElementStateCondition state="runningState" storyboardElementRef="Act4" storyboardElementType="act"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
            <Act name="Act5">
                <ManeuverGroup maximumExecutionCount="1" name="Act5_GlobalGroup">
                    <Actors selectTriggeringEntities="false"/>
                    <Maneuver name="Act5_Maneuver">
                        <Event name="ForceActToExecuteUntilStopTrigger4" priority="parallel">
                            <Action name="NeverExecutedAction4">
                                <UserDefinedAction>
                                    <CustomCommandAction type="MW_WaitAction"/>
                                </UserDefinedAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition conditionEdge="none" delay="0" name="NeverSatisfiedCondition4">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition state="completeState" storyboardElementRef="Story" storyboardElementType="story"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="0" name="SimulationStart5">
                            <ByValueCondition>
                                <SimulationTimeCondition rule="greaterOrEqual" value="0"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger>
                    <ConditionGroup>
                        <Condition conditionEdge="none" delay="5" name="Duration4">
                            <ByValueCondition>
                                <StoryboardElementStateCondition state="runningState" storyboardElementRef="Act5" storyboardElementType="act"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition conditionEdge="none" delay="0" name="">
                    <ByValueCondition>
                        <SimulationTimeCondition rule="greaterOrEqual" value="60"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
            <ConditionGroup>
                <Condition conditionEdge="none" delay="0" name="">
                    <ByEntityCondition>
                        <TriggeringEntities triggeringEntitiesRule="any">
                            <EntityRef entityRef="Backhoe"/>
                            <EntityRef entityRef="CementTruck"/>
                            <EntityRef entityRef="CompactCar"/>
                            <EntityRef entityRef="Ambulance"/>
                        </TriggeringEntities>
                        <EntityCondition>
                            <CollisionCondition>
                                <ByType type="vehicle"/>
                            </CollisionCondition>
                        </EntityCondition>
                    </ByEntityCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>